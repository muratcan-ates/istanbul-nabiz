# İstanbul Nabız — every environment variable this project reads, plus (section 6) the
# few the deployment sets for it.
#
# Copy to `.env` and edit. `.env` is gitignored; `.env.example` is not, so KEEP THIS FILE
# FREE OF REAL VALUES — no keys, no connection strings, no cluster URIs from a live
# subscription. Placeholders only.
#
# NOTHING IN THIS REPO LOADS `.env` AUTOMATICALLY. There is no python-dotenv dependency,
# on purpose: the MCP server is launched by other people's clients (VS Code, Claude
# Desktop, a container) and a file that silently changes behaviour depending on the working
# directory is a debugging trap. Load it yourself when you want it:
#
#     set -a; . ./.env; set +a          # bash / zsh, current shell only
#
# In deployment the same names are set as Container Apps / Functions app settings, and MCP
# clients pass them in the `env` block of their own config (see docs/mcp-usage.md).
#
# Legend:
#   [live]    read by code in the tree today — grep the name to find where
#   [planned] the agreed name for a tier that has not landed yet; nothing reads it so far


# ── 1. MCP server ────────────────────────────────────────────────────────────────────
# Required for: nothing. Every one of these has a working default, and `ibb-mcp` runs with
# an empty environment. Set them to move the reference data or to change demo behaviour.

# [live] Serve recorded fixtures instead of calling api.ibb.gov.tr. "1", "true" or "yes"
# turn it on. Use it for tests, CI and any demo that must not depend on the network — and
# to stay out of the shared İETT budget (100 requests/hour, documented). Equivalent to the
# `ibb-mcp --offline` flag. Default: off.
NABIZ_OFFLINE=

# [live] Directory holding the İETT GTFS extract (stops.csv, routes.csv, trips.csv,
# stop_times.csv) plus the generated route_sequences.json.gz. These files are NOT committed
# — they are ~35 MB — so a fresh clone must point this somewhere real or download them
# (`ibb_mcp.gtfs.download_gtfs`, resource URLs in tests/fixtures/gtfs_resources.json).
# Absolute paths only when an MCP client launches the server: it does not inherit your cwd.
# Default: <repo>/data/reference/gtfs
NABIZ_GTFS_DIR=

# [live] The gazetteer CSV behind `places_resolve` ("Taksim" → lat/lon/district).
# Committed, rebuildable with `make places`. Default: <repo>/data/reference/places.csv
NABIZ_PLACES_CSV=

# [live] Where offline mode reads recorded İBB responses from.
# Default: <repo>/tests/fixtures
NABIZ_FIXTURES_DIR=

# [live] Default search radius in km for `ispark_find_parking` when the caller does not
# pass one. Default: 1.5
NABIZ_RADIUS_KM=

# [live] Default cap on how many results a tool returns. Default: 5
NABIZ_MAX_RESULTS=


# ── 2. History store: collector + analytics ──────────────────────────────────────────
# Required for: the collector (src/nabiz/collector/) and, later, for
# `ispark_typical_occupancy` / `air_quality_forecast` to answer with real numbers. With all
# of these unset the collector still runs and writes to a local lake, and the MCP server
# still serves every live tool; the two history-backed tools return `available: false` and
# say why, which is the expected state until the Day-0 ADX gate passes (DECISIONS #1).

# [live] Local lake root used when no storage account is configured.
# Default: data/lake (gitignored)
NABIZ_LAKE_DIR=

# [live] Local lake file format: auto | delta | json. `auto` writes Delta when the
# `deltalake` + `pyarrow` wheels are installed (the `collector` extra) and NDJSON.gz
# otherwise. Default: auto
NABIZ_LAKE_FORMAT=

# [live] Blob container for bronze snapshots. Default: bronze
NABIZ_LAKE_CONTAINER=

# [live] ADLS Gen2 / blob storage account NAME (not a URL, not a key). Setting it switches
# the lake writer from the local directory to Azure, authenticating with the collector's
# managed identity. Shape: stnabiz<suffix>
AZURE_STORAGE_ACCOUNT=

# [live] *** SECRET — a full storage connection string embeds an account key. ***
# Development-only fallback for when no managed identity is available (e.g. Azurite, or a
# laptop that is not `az login`-ed). Prefer AZURE_STORAGE_ACCOUNT + managed identity
# everywhere else, and never put a real value in this file.
AZURE_STORAGE_CONNECTION_STRING=

# [live] Azure Data Explorer free-cluster endpoint. Not itself a secret — access is granted
# to a principal, not to whoever knows the URI — but it names a real cluster, so keep the
# value in .env. Unset means the Kusto writer reports itself unconfigured instead of
# failing. Shape:
# NABIZ_KUSTO_URI=https://<cluster>.<region>.kusto.windows.net
NABIZ_KUSTO_URI=

# [live] Kusto database name. Default: nabiz
NABIZ_KUSTO_DB=

# [live] Client id of the user-assigned managed identity the collector authenticates with.
# The ADX free cluster has no managed identity of its own, but it accepts the *caller's* as
# a Kusto principal:
#   .add database <db> ingestors ('aadapp=<clientId>;<tenantId>')
# A client id is a public GUID, not a credential — with a managed identity there is no
# secret to store anywhere, which is the entire point of using one.
NABIZ_KUSTO_MI_CLIENT_ID=

# [live] Force the Kusto credential instead of letting `choose_auth()` pick: msi | azcli |
# device. Unset is right almost always — the collector picks msi when
# NABIZ_KUSTO_MI_CLIENT_ID is set, az-cli when the `az` binary is on PATH, and device code
# otherwise. Set it to `azcli` on a laptop that has a managed identity id in its .env, or
# to `device` in a container with no browser-less credential. Never set `device` in Azure:
# it blocks on a human at a browser. Code: src/nabiz/collector/kusto.py.
NABIZ_KUSTO_AUTH=


# ── 3. LLM for the Nabız agent ───────────────────────────────────────────────────────
# Required for: the agent and the eval harness. The MCP server never calls a model, so all
# three stay empty for MCP-only work. Three names instead of one provider setting is
# deliberate (DECISIONS #5): Azure OpenAI quota on Azure for Students is uncertain and
# GitHub Models was retired on 2026-07-30, so the model has to be swappable without a code
# change — Azure OpenAI, a Foundry serverless deployment, or Foundry Local on the laptop.

# All three are read by src/nabiz/agent/llm.py today. Each also accepts an unprefixed
# alias — LLM_BASE_URL, LLM_API_KEY, LLM_MODEL — so a shell that already exports the
# generic names works unchanged; the NABIZ_ name wins when both are set.

# [live] OpenAI-compatible base URL. Examples of the SHAPE (none of these is live):
#   Azure OpenAI    https://<resource>.openai.azure.com/openai/v1
#   Foundry Local   http://localhost:5273/v1
NABIZ_LLM_BASE_URL=

# [live] *** SECRET — never commit a value, never paste one into this file. ***
# Leave empty for Foundry Local, which needs no key. Prefer a managed identity or
# `az login` over a key wherever the endpoint supports it.
NABIZ_LLM_API_KEY=

# [live] Deployment or model name. Shape: gpt-4.1-mini / phi-4-mini / qwen2.5-7b
NABIZ_LLM_MODEL=

# [live] Skip the localhost:5273 probe that auto-detects a running Foundry Local. "1",
# "true" or "yes" turn the probe off. Worth setting in CI and in tests: the probe is a
# 0.25 s TCP connect, but it is still an outbound connection nobody asked for.
NABIZ_LLM_NO_PROBE=


# ── 4. Web UI ────────────────────────────────────────────────────────────────────────
# Required for: nothing. `make web` runs with all of these unset.

# [live] *** SECRET-ish — a client-side Azure Maps subscription key. ***
# Only the map needs it; the chat answers work without one, and the documented fallback is
# MapLibre + OpenStreetMap tiles, which needs no key at all. Restrict any key you do create
# to the deployed origin: it is served to the browser.
NABIZ_MAPS_KEY=

# [live] Bind address and port when the web app is started as a module. Container Apps
# needs 0.0.0.0. Defaults: 127.0.0.1 and 8000. (`make web` passes --port 8080 instead, so
# it does not collide with `make mcp-http`.)
NABIZ_HOST=
NABIZ_PORT=

# [live] Comma-separated CORS allow-list, or `*`. Empty by default because the single page
# is served by the same app, so same-origin fetches need no CORS header. Only set this for
# a separately hosted front end.
NABIZ_CORS_ORIGINS=

# ── 5. Telemetry ─────────────────────────────────────────────────────────────────────

# [planned] *** SECRET — contains an InstrumentationKey. ***
# Application Insights connection string for OpenTelemetry traces (agent → MCP tool →
# model). Unset means telemetry is simply off; nothing else changes. Shape:
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=<guid>;IngestionEndpoint=https://<region>.in.applicationinsights.azure.com/
APPLICATIONINSIGHTS_CONNECTION_STRING=


# ── 6. Set by the deployment, not by you ─────────────────────────────────────────────
# These names exist in the deployed environment only — infra/modules/*.bicep writes them as
# app settings — so there is nothing to fill in here. They are listed because this file
# claims to account for every name the project uses, and a name you meet in the portal or
# in a log should be findable here.
#
#   AZURE_CLIENT_ID                            the user-assigned managed identity the
#                                              Azure SDK's DefaultAzureCredential picks up;
#                                              set by Bicep on the Function App and the
#                                              container app.
#   APPLICATIONINSIGHTS_AUTHENTICATION_STRING  tells the Application Insights exporter to
#                                              authenticate with that identity instead of
#                                              with the instrumentation key.
#   NABIZ_SCHEDULE_ISPARK                      NCRONTAB strings for the five collector
#   NABIZ_SCHEDULE_IETT_FLEET                  timers. Bicep sets them, but the timer
#   NABIZ_SCHEDULE_METRO                       triggers in src/nabiz/collector/function_app.py
#   NABIZ_SCHEDULE_TRAFFIC                     currently bind literal crons, so these
#   NABIZ_SCHEDULE_AIR_QUALITY                 settings are inert until that code reads
#                                              them as '%NABIZ_SCHEDULE_ISPARK%'.
