  "quotes": {
    "kanallar": {
      "source": "d2780",
      "parts": [
        "İstanbulkart’a TL yükleme işlemleri İstanbulkart Mobil üzerinden, İstanbulkart Plus görseli olan biletmatiklerden ya da ATM’lerden para yatırarak yapılabilir."
      ]
    },
    "ogrenci_vize": {
      "source": "d2768",
      "parts": [
        "İstanbulkart Mobil ile ayrıca:",
        "Öğrenci İstanbulkart’ını vizelyebilir,"
      ]
    },
    "engelli_kim": {
      "source": "d2762",
      "parts": [
        "Yalnızca Sağlık Bakanlığı sistemlerinde rapor bilgisi doğrulanamayan ve bu nedenle SMS ile bilgilendirilen engelli İstanbulkart kullanıcılarının güncel rapor numarasını iletmesi gerekiyor."
      ]
    },
    "engelli_sms_yok": {
      "source": "d2762",
      "parts": [
        "Hayır, rapor bilgisi doğrulanan ve ücretsiz ulaşım hakkı tanımlanan kullanıcıların herhangi bir işlem yapmasına gerek yoktur."
      ]
    },
    "engelli_nasil": {
      "source": "d2762",
      "parts": [
        "Güncelleme yapmak için; ISTRPR yazdıktan sonra boşluk bırakıp T.C. Kimlik Numarası yazıp boşluk bırakıp Rapor Numarası yazılarak 6235’e SMS gönderilmesi gerekiyor."
      ]
    },
    "engelli_gec": {
      "source": "d2762",
      "parts": [
        "Evet, 30 Haziran’dan sonra da güncel rapor numarası iletilebilir; ancak rapor bilgisi doğrulanana kadar ücretsiz geçiş hakkı tanımlanamayacağı için bu sürede geçişler ücretli olur."
      ]
    },
    "engelli_153": {
      "source": "d2762",
      "parts": [
        "Konuya ilişkin bilgi almak isteyen vatandaşlar ALO 153 Çağrı Merkezi üzerinden destek alabilir; İstanbulkart’ın resmi web sitesi ve sosyal medya hesaplarından yapılan duyuruları takip edebilir."
      ]
    },
    "basvuru_1": {
      "source": "d2768",
      "parts": [
        "istanbulkart.istanbul adresinden “Online İşlemler” sekmesindeki ‘Bireysel İşlemler’ seçeneğine gidilir."
      ]
    },
    "basvuru_2": {
      "source": "d2768",
      "parts": [
        "bireysel.istanbulkart.istanbul adresine telefon numarasıyla kayıt olunur ya da giriş yapılır."
      ]
    },
    "basvuru_3": {
      "source": "d2768",
      "parts": [
        "Bireysel İstanbulkart profili oluşturulduktan sonra ana sayfada yer alan ‘Kart Başvurusu’ seçeneğine gidilir."
      ]
    },
    "basvuru_4": {
      "source": "d2768",
      "parts": [
        "Başvuru seçenekleri arasında ‘Öğrenci’ seçilir.",
        "Yönlendirmeler takip edilerek gerekli bilgiler doldurulur ve teslimat tercihi yapılır."
      ]
    },
    "basvuru_istanbul_disi": {
      "source": "d2768",
      "parts": [
        "İstanbul dışına teslimat yapılamamaktadır."
      ]
    },
    "basvuru_mevcut": {
      "source": "d2768",
      "parts": [
        "Mevcut Öğrenci İstanbulkart sahipleri yeni kart başvurusunda bulunamaz. Mevcut kartlarını kullanmaya devam edebilir."
      ]
    },
    "plus_basvuru": {
      "source": "d2780",
      "parts": [
        "Kişiye özel kartlar için İstanbulkart Mobil uygulaması veya İstanbulkart web sitesi üzerinden başvuru yapılabilir; isimsiz kart sahibi olmak isteyenler ise Karaköy ve Kadıköy İstanbulkart Başvuru Merkezlerinden başvuru yapabilir."
      ]
    },
    "resmi_kanal": {
      "source": "d2815",
      "parts": [
        "İstanbulkart işlemlerinizi yalnızca İstanbulkart’ın resmi internet sitesi; istanbulkart.istanbul , İstanbulkart Mobil ve yetkili kanallar üzerinden gerçekleştirin."
      ]
    },
    "adres_kontrol": {
      "source": "d2815",
      "parts": [
        "İstanbulkart görünümünü taklit eden sahte internet siteleri gerçek sayfalara oldukça benzer görünebilir. Kişisel veya kart bilgilerinizi girmeden önce bulunduğunuz sayfanın internet adresini dikkatlice inceleyin."
      ]
    },
    "sms_kod": {
      "source": "d2815",
      "parts": [
        "SMS doğrulama kodunu girmeden önce mesajda yer alan işlem, işyeri ve tutar bilgilerini mutlaka kontrol edin. Beklediğiniz işlemle eşleşmeyen bir bilgi görürseniz doğrulama kodunu kullanmayın."
      ]
    },
    "supheli": {
      "source": "d2815",
      "parts": [
        "Beklemediğiniz bir yönlendirme, farklı bir tutar veya şüpheli bir işlemle karşılaşırsanız bilgilerinizi paylaşmayın, doğrulama kodunu girmeyin ve işlemi sonlandırın."
      ]
    }
  },
