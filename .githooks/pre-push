#!/bin/sh
# The authorship gate, run before the commits are public instead of after.
#
# CI runs scripts/check_authorship.py on every push, but main has no branch protection, so
# on a direct push CI only reports a commit that is already permanent public history. This
# hook runs the same check on the same range first, and refuses the push if it fails.
#
# Enable once per clone (it is a git setting, so nothing turns it on for you):
#     make hooks          # = git config core.hooksPath .githooks
#
# git feeds one line per pushed ref on stdin: <local ref> <local sha> <remote ref> <remote sha>.
# A remote sha of all zeros means the push creates the branch; check_authorship.py then
# checks the tip, exactly as CI does.

here=$(cd "$(dirname "$0")/.." && pwd) || exit 1
repo=$(git rev-parse --show-toplevel) || exit 1
python="$here/.venv/bin/python"
# The gate is standard library only, so any Python 3 can run it when the venv is missing.
[ -x "$python" ] || python=$(command -v python3) || {
    echo "pre-push: no .venv/bin/python and no python3; run make install" >&2
    exit 1
}

status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
    case "$local_sha" in
        *[!0]*) ;;
        *) continue ;;  # deleting a remote branch publishes no commit
    esac
    "$python" "$here/scripts/check_authorship.py" --repo "$repo" --push "$remote_sha" "$local_sha" || status=1
done
exit $status
